# NKeeper settings for the single-container image. The first start copies this file to
# /var/lib/nkeeper/nkeeper.env; edit that copy, then restart the container. Variables set on the
# container itself (docker run -e, or the Proxmox container's environment) take precedence.
# Any API setting from docs/configuration.md can also go here, e.g. ActiveDirectory__Enabled=true.

# Space-separated host names and IP addresses people use to open NKeeper. The HTTPS certificate
# covers them (and *.web.<name> for web sessions). Empty: the container's hostname and its IP
# addresses, detected at every start.
NKEEPER_SERVER_NAMES=

# The HTTPS port people use, when it isn't 443 (e.g. docker run -p 8443:443 needs 8443 here, so
# the HTTP->HTTPS redirect points at the right port).
NKEEPER_HTTPS_PORT=443

# Optional separate domain for web session origins (nkw-<id>.<domain>); needs a wildcard DNS
# record. Empty: web.<the name NKeeper is opened with>.
NKEEPER_WEB_BASE_DOMAIN=

# The first administrator, created on the first start only. Without a password, a random one is
# generated and written to /var/lib/nkeeper/initial-admin.txt.
NKEEPER_ADMIN_USERNAME=admin
NKEEPER_ADMIN_EMAIL=admin@nkeeper.local
NKEEPER_ADMIN_PASSWORD=
