# Docker Compose settings. scripts/setup.sh (or setup.ps1) writes .env for you;
# to do it by hand, copy this to .env and adjust. .env is git-ignored; never
# commit real secrets. Every variable is described in docs/configuration.md.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=nkeeper
POSTGRES_USER=nkeeper
# REQUIRED. Use a long random value of letters and digits (it is embedded in a
# connection string, so avoid ';' and quotes). Example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Loopback ports for local development with docker-compose.dev.yml.
POSTGRES_DEV_PORT=5432
GUACD_DEV_PORT=4822

# --- Web frontend ------------------------------------------------------------
# Plain-HTTP port of the app: for http://localhost, or for an outer reverse
# proxy that terminates TLS. Keep it on 127.0.0.1 (or a private interface).
NKEEPER_HTTP_BIND=127.0.0.1
NKEEPER_HTTP_PORT=8080
# HTTPS (port 8443 inside the container) and an HTTP->HTTPS redirect. A server
# install publishes these on 0.0.0.0, ports 443 and 80.
NKEEPER_HTTPS_BIND=127.0.0.1
NKEEPER_HTTPS_PORT=8443
NKEEPER_HTTP_REDIRECT_PORT=8081
# Space-separated host names and IP addresses clients use to open NKeeper. The
# self-signed certificate (from NKeeper's private CA) covers them, plus
# *.web.<name> for web sessions. To use your own certificate, see
# docs/installation.md.
NKEEPER_SERVER_NAMES=localhost
# Optional separate domain for web session origins (nkw-<id>.<domain>); needs a
# wildcard DNS record. Empty = web.<the name NKeeper is opened with>.
NKEEPER_WEB_BASE_DOMAIN=
# Leave empty so the browser calls /api on the same origin (nginx proxies it).
VITE_API_BASE_URL=

# --- API ---------------------------------------------------------------------
# Apply EF Core migrations when the API container starts.
NKEEPER_MIGRATE_ON_STARTUP=true
# Keep true. Browsers accept Secure cookies on http://localhost; for any other
# host serve NKeeper over HTTPS. Setting false is only for throwaway test setups.
NKEEPER_REQUIRE_SECURE_COOKIES=true

# --- One-time initial administrator --------------------------------------------
# The setup scripts handle this. Disabled by default. To create the first admin
# in Docker by hand (Production mode),
# set all values below plus ALLOW_OUTSIDE_DEVELOPMENT=true, start once, sign in,
# then set ENABLED=false and delete the password from this file. An existing
# account is never modified, so leaving it enabled cannot reset a password.
NKEEPER_BOOTSTRAP_ADMIN_ENABLED=false
NKEEPER_BOOTSTRAP_ADMIN_ALLOW_OUTSIDE_DEVELOPMENT=false
NKEEPER_BOOTSTRAP_ADMIN_USERNAME=
NKEEPER_BOOTSTRAP_ADMIN_EMAIL=
# Minimum 12 characters with upper case, lower case and a digit.
NKEEPER_BOOTSTRAP_ADMIN_PASSWORD=
