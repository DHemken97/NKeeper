# Copy to .env and adjust. .env is git-ignored; never commit real secrets.

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=nkeeper
POSTGRES_USER=nkeeper
# REQUIRED. Use a long random value of letters and digits (it is embedded in a
# connection string, so avoid ';' and quotes). Example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host port for PostgreSQL when using docker-compose.dev.yml (bound to 127.0.0.1 only).
POSTGRES_DEV_PORT=5432

# --- Web frontend ------------------------------------------------------------
# Interface and port the app is published on. 127.0.0.1 keeps it local; use
# 0.0.0.0 only behind an HTTPS reverse proxy or on a trusted network.
NKEEPER_HTTP_BIND=127.0.0.1
NKEEPER_HTTP_PORT=8080
# Leave empty so the browser calls /api on the same origin (nginx proxies it).
VITE_API_BASE_URL=

# --- API ---------------------------------------------------------------------
# Apply EF Core migrations when the API container starts.
NKEEPER_MIGRATE_ON_STARTUP=true
# Keep true. Browsers accept Secure cookies on http://localhost; for any other
# host serve NKeeper over HTTPS. Setting false is only for throwaway test setups.
NKEEPER_REQUIRE_SECURE_COOKIES=true

# --- One-time initial administrator --------------------------------------------
# Disabled by default. To create the first admin in Docker (Production mode),
# set all values below plus ALLOW_OUTSIDE_DEVELOPMENT=true, start once, sign in,
# then set ENABLED=false and delete the password from this file. An existing
# account is never modified, so leaving it enabled cannot reset a password.
NKEEPER_BOOTSTRAP_ADMIN_ENABLED=false
NKEEPER_BOOTSTRAP_ADMIN_ALLOW_OUTSIDE_DEVELOPMENT=false
NKEEPER_BOOTSTRAP_ADMIN_USERNAME=
NKEEPER_BOOTSTRAP_ADMIN_EMAIL=
# Minimum 12 characters with upper case, lower case and a digit.
NKEEPER_BOOTSTRAP_ADMIN_PASSWORD=
