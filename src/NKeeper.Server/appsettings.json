{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=nkeeper.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoCreate": true,
    "DataProtectionKeysPath": null
  },
  "Authentication": {
    "LocalDatabaseEnabled": true,
    "AutoProvisionExternalUsers": true,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "TotpIssuer": "NKeeper",
    "Jwt": {
      "Issuer": "nkeeper",
      "Audience": "nkeeper-api",
      "MfaAudience": "nkeeper-mfa",
      "SessionLifetimeMinutes": 480,
      "MfaPendingLifetimeMinutes": 5
    },
    "ActiveDirectory": {
      "Enabled": false,
      "Server": "",
      "Port": 636,
      "UseSsl": true,
      "UseStartTls": false,
      "AllowInsecureBind": false,
      "Domain": "",
      "BaseDn": "",
      "RequiredGroupDn": "",
      "AdminGroupDn": "",
      "TimeoutSeconds": 10
    },
    "LinuxPam": {
      "Enabled": false,
      "ServiceName": "nkeeper"
    }
  },
  "Modules": {
    "inventory": {
      "Enabled": true
    }
  }
}
