{
  // NKeeper's own plugins' browser parts (../plugins/*/frontend), type-checked against the web app's
  // SDK, React and test tools, as their builds and tests see them.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.plugins.tsbuildinfo",
    "paths": {
      "@nkeeper/plugin-sdk": ["./src/sdk/index.ts"],
      "@nkeeper/plugin-sdk/testing": ["./src/sdk/testing.ts"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "react-router": ["./node_modules/react-router/dist/production/index.d.ts"],
      "@testing-library/*": ["./node_modules/@testing-library/*"],
      "vitest": ["./node_modules/vitest"]
    },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["../plugins/*/frontend/src", "src/**/*.d.ts", "src/test/setup.ts"]
}
