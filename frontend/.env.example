# Base URL the browser uses for API calls.
# Leave empty (recommended) to call the API on the same origin as the frontend:
#   - `npm run dev`: Vite proxies /api to DEV_API_PROXY_TARGET
#   - Docker: nginx proxies /api to the backend container
# Set it only when the API is served from a different origin, e.g. http://localhost:5080
# (that origin must then be listed in the API's Cors__AllowedOrigins).
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api requests.
DEV_API_PROXY_TARGET=http://localhost:5080
