# NKeeper over HTTPS. Generated by nkeeper-tls.sh from tls.conf.template: edits are overwritten.

server {
    listen @HTTPS_LISTEN@ ssl default_server;
    server_name _;
    root @ROOT@;
    server_tokens off;
    client_max_body_size 1m;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:nkeeper_tls:10m;
    ssl_session_timeout 1d;
    include snippets/nkeeper/app-locations.conf;
}

server {
    listen @HTTPS_LISTEN@ ssl;
    server_name "~^nkw-[0-9a-f]{32}\.";
    server_tokens off;
    client_max_body_size 1g;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:nkeeper_tls:10m;
    ssl_session_timeout 1d;
    include snippets/nkeeper/web-session-locations.conf;
}

# Plain HTTP only redirects to HTTPS (sign-in needs HTTPS anywhere but localhost).
server {
    listen @REDIRECT_LISTEN@;
    server_name @SERVER_NAMES@;
    server_tokens off;
    return 301 https://$host@HTTPS_PORT_SUFFIX@$request_uri;
}
