<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1848/CA1873: LoggerMessage source generators are not worth the ceremony at this size. -->
    <!-- CA1515: controllers/DTOs must be public for MVC and the test project. -->
    <!-- CA1711/CA1716/CA1062: noisy for ASP.NET Core conventions with nullable reference types enabled. -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1515;CA1711;CA1716;CA1062;CA2007</NoWarn>
  </PropertyGroup>
</Project>
