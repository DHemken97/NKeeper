<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The NKeeper plugin SDK: what a plugin's server part builds on (hosts and access, sessions and their targets, SSH, audit, consoles, per-plugin settings).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NKeeper.Infrastructure\NKeeper.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NKeeper.Api" />
    <InternalsVisibleTo Include="NKeeper.Api.Tests" />
  </ItemGroup>

  <!-- The usings the Web SDK implies, so code moved from the API reads the same. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

</Project>
