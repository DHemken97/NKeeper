{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NKeeper": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Authentication": {
    "CookieName": "NKeeper.Session",
    "SessionTimeout": "08:00:00",
    "RememberMeDuration": "14.00:00:00",
    "RequireSecureCookies": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownNetworks": []
  },
  "BootstrapAdmin": {
    "Enabled": false,
    "AllowOutsideDevelopment": false
  }
}
