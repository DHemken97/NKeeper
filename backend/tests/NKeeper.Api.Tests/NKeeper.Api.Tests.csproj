<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Test names use underscores; inline test-data arrays (CA1861) are clearer than static fields. -->
    <NoWarn>$(NoWarn);CA1707;CA2234;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Kvm/fake-*.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Storage/fake-*.sh" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Migration/fake-*.sh" CopyToOutputDirectory="PreserveNewest" />
    <!-- A real mRemoteNG export (test hosts and test passwords, default master password). -->
    <None Include="Import/mremoteng-export.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NKeeper.Api\NKeeper.Api.csproj" />
    <!-- NKeeper's own plugins, which NKeeperApiFactory loads as built-in plugins (Plugins:BuiltIn). -->
    <ProjectReference Include="..\..\..\plugins\idrac\backend\NKeeper.Plugins.Idrac.csproj" />
    <ProjectReference Include="..\..\..\plugins\zabbix\backend\NKeeper.Plugins.Zabbix.csproj" />
    <!-- Built, not referenced: the tests package it and load it as a plugin, in its own load context. -->
    <ProjectReference Include="..\NKeeper.SamplePlugin\NKeeper.SamplePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <ItemGroup>
      <SamplePluginFiles Include="..\NKeeper.SamplePlugin\bin\$(Configuration)\$(TargetFramework)\NKeeper.SamplePlugin.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)" DestinationFolder="$(OutDir)sample-plugin" SkipUnchangedFiles="true" />
  </Target>

</Project>
