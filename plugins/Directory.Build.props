<Project>
  <!-- NKeeper's own plugins build like the server: .NET 10, nullable, warnings as errors. -->
  <Import Project="..\backend\Directory.Build.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The server's loader resolves a plugin's own dependencies from its .deps.json. -->
    <GenerateDependencyFile>true</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The server provides the SDK (and what it brings: EF Core, SSH.NET…), so it isn't copied into the plugin. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\backend\src\NKeeper.Sdk\NKeeper.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\backend\src\NKeeper.Infrastructure\NKeeper.Infrastructure.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NKeeper.Api.Tests" />
  </ItemGroup>

  <!-- The usings the Web SDK implies, as in the server. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>
</Project>
